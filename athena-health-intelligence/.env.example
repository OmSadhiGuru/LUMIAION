# Copy to .env and fill in as needed. Never commit the real .env file.

# Root directory for ATHENA's local data (defaults to this project directory if unset).
ATHENA_HOME=

# Optional: only required once the Strava adapter is implemented (see athena/adapters/strava.py).
# Not read or used anywhere yet — placeholders only.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
